# ---------------------------------------------------------------- football data
# Free key from https://dashboard.api-football.com (100 requests/day).
# This is the only provider whose free tier covers all six competitions:
# Serie A, Champions League, Europa League, Conference League, Coppa Italia,
# Supercoppa Italiana.
API_FOOTBALL_KEY=

# Only set this if your key came from RapidAPI rather than api-football.com:
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# ------------------------------------------------------------------- storage
# Add an Upstash Redis / Vercel KV store and Vercel injects these for you.
# Without them the app still runs, but players are kept in memory and vanish.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------- game setup
# Season the draw pool comes from. 2025 means the 2025/26 campaign.
# DRAW_SEASON=2025
# Season whose results score points. 2026 means 2026/27.
# TRACK_SEASON=2026
# How many clubs off the top of the table go into the draw.
# TOP_N=7

# Pin the draw pool by hand, in finishing order, as "teamId:Name".
# Useful if your plan cannot read the 2025/26 standings. Team ids come from
# api-football (Inter 505, Napoli 492, Atalanta 499, Juventus 496, Milan 489,
# Roma 497, Lazio 487, Fiorentina 502, Bologna 500).
# SERIE_A_TOP7=505:Inter,492:Napoli,499:Atalanta,496:Juventus,489:AC Milan,497:AS Roma,487:Lazio

# ------------------------------------------------------------------- scoring
# POINTS_PER_GOAL=1
# POINTS_CLEAN_SHEET=2

# --------------------------------------------------------------- league ids
# Only needed if the provider ever renumbers a competition. Check yours with
# GET /api/leagues on the running app.
# LEAGUE_ID_SERIE_A=135
# LEAGUE_ID_CHAMPIONS_LEAGUE=2
# LEAGUE_ID_EUROPA_LEAGUE=3
# LEAGUE_ID_CONFERENCE_LEAGUE=848
# LEAGUE_ID_COPPA_ITALIA=137
# LEAGUE_ID_SUPERCOPPA=547

# -------------------------------------------------------------------- limits
# Cache lifetimes in seconds, and the manual-refresh cooldown. The defaults
# keep a 7 team game inside roughly 30 API calls a day.
# STANDINGS_TTL=86400
# FIXTURES_TTL=21600
# REFRESH_COOLDOWN=600
# MAX_PLAYERS=200

# Set this and Vercel will send it as a bearer token on the daily cron call.
# CRON_SECRET=
