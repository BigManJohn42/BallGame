# ---------------------------------------------------------------- football data
# There is nothing to configure. Data comes from ESPN's public soccer API:
# no account, no key, no quota. If it ever moves, override the slugs below.

# ------------------------------------------------------------------- storage
# Add an Upstash Redis / Vercel KV store and Vercel injects these for you.
# Without them the app still runs, but players are kept in memory and vanish.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------- game setup
# Season the draw pool comes from. 2025 means the 2025/26 campaign.
# DRAW_SEASON=2025
# Season whose results score points. 2026 means 2026/27.
# Set this to 2025 to watch the game play out over the completed season instead.
# TRACK_SEASON=2026
# How many clubs off the top of the table go into the draw.
# TOP_N=7

# Pin the draw pool by hand, in finishing order, as "teamId:Name". Only needed
# if ESPN stops serving the standings. Ids are ESPN team ids:
# Inter 110, Napoli 114, Roma 104, Como 2572, Milan 103, Juventus 111,
# Atalanta 105, Bologna 107, Lazio 112, Fiorentina 109.
# SERIE_A_TOP7=110:Internazionale,114:Napoli,104:AS Roma,2572:Como,103:AC Milan,111:Juventus,105:Atalanta

# --------------------------------------------------------------- head to head
# How wide a "round" is when announcing fixtures between two clubs in the game.
# Four days covers a Friday-to-Monday Serie A weekend.
# DERBY_WINDOW_HOURS=96
# How long previous-meetings data is cached, in seconds.
# H2H_TTL=43200

# ------------------------------------------------------------------ profiles
# Club histories, honours and legends are written by hand in src/lib/clubs.ts.
# The manager is the only part that dates, so it can be corrected here without
# a code change. Ids are ESPN team ids.
# MANAGERS=110:Cristian Chivu,114:Antonio Conte

# ------------------------------------------------------------------- scoring
# POINTS_PER_GOAL=1
# POINTS_CLEAN_SHEET=2

# Every competition shares these, deliberately.
# POINTS_WIN=3
# POINTS_DRAW=1

# One-off award for topping a stat among the clubs in the game: top scorer,
# top assister, most goals+assists, most saves, most clean sheets.
# POINTS_STAT_AWARD=5

# Cup progress. Only the furthest round reached is paid out.
# POINTS_ROUND_PLAYOFF=1
# POINTS_ROUND_32=2
# POINTS_ROUND_16=3
# POINTS_ROUND_QF=5
# POINTS_ROUND_SF=7
# POINTS_ROUND_FINAL=8
# POINTS_TROPHY=10

# Reaching the last 16 in Europe without having to win a playoff.
# POINTS_AUTO_R16=3

# Serie A finishing position. Only the highest applies.
# POINTS_FINISH_CHAMPIONS=12
# POINTS_FINISH_UCL=8
# POINTS_FINISH_EUROPA=5
# POINTS_FINISH_CONFERENCE=3

# How long player-stat leaders are cached, in seconds.
# LEADERS_TTL=43200

# ------------------------------------------------------------- league slugs
# ESPN league slugs. Only touch these if a competition moves or gets renamed;
# GET /api/leagues on the running app checks all six.
# LEAGUE_SLUG_SERIE_A=ita.1
# LEAGUE_SLUG_CHAMPIONS_LEAGUE=uefa.champions
# LEAGUE_SLUG_EUROPA_LEAGUE=uefa.europa
# LEAGUE_SLUG_CONFERENCE_LEAGUE=uefa.europa.conf
# LEAGUE_SLUG_COPPA_ITALIA=ita.coppa_italia
# LEAGUE_SLUG_SUPERCOPPA=ita.super_cup

# -------------------------------------------------------------------- limits
# Cache lifetimes in seconds, and the manual-refresh cooldown.
# STANDINGS_TTL=86400
# FIXTURES_TTL=10800
# REFRESH_COOLDOWN=60
# MAX_PLAYERS=200

# Set this and Vercel will send it as a bearer token on the daily cron call.
# CRON_SECRET=
